# Local compatibility demo; set production for BGE + Milvus + Elasticsearch.
RAG_BACKEND=local
RAG_INDEX_VERSION=v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=cpu
MODEL_MAX_LENGTH=1024
EMBEDDING_BATCH_SIZE=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DENSE_CANDIDATES=20
SPARSE_CANDIDATES=20
RERANK_CANDIDATES=20
RRF_K=60
SEARCH_TIMEOUT=30
ELASTICSEARCH_URL=http://localhost:9200
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=
MILVUS_TOKEN=
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
